# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-at-least-32-chars

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dear_more

# Model Settings
MODEL_STORAGE_PATH=./models
BATCH_SIZE=32
EMBEDDING_DIM=64
INPUT_DIM=200
LEARNING_RATE=0.001
EPOCHS=50
TRIPLET_MARGIN=0.5

# Training Settings
MIN_SAMPLES_PER_CLASS=10
VALIDATION_SPLIT=0.2
